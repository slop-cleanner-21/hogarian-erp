{
  "name": "erp-prod1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev -p 3100",
    "build": "node --max-old-space-size=6144 node_modules/next/dist/bin/next build",
    "start": "node --max-old-space-size=4096 node_modules/next/dist/bin/next start -p 3100",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:demo-entregas": "node --env-file=.env.local scripts/demo-entregas.mjs",
    "db:simular": "node --env-file=.env.local scripts/simular-obra.mjs",
    "db:demo-archivos": "node --env-file=.env.local scripts/demo-archivos.mjs",
    "db:demo-fotos": "node --env-file=.env.local scripts/demo-fotos.mjs",
    "db:demo-requerimientos": "node --env-file=.env.local scripts/demo-requerimientos.mjs",
    "db:demo-tesoreria": "node --env-file=.env.local scripts/demo-tesoreria-logistica.mjs mvp && node --env-file=.env.local scripts/demo-tesoreria-logistica.mjs prod1"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
